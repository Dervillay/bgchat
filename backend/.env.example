# Flask Configuration
FLASK_ENV=development
# Options: development, production

# Frontend URLs (comma-separated, optional)
# Used for CORS configuration. In development, localhost:3000 is automatically allowed.
# Example: FRONTEND_URLS=https://example1.com,https://www.example2.com
FRONTEND_URLS=

# Security
# Generate a secure random key (at least 32 characters)
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here

# MongoDB Configuration
MONGODB_HOST=your-mongodb-host-here
MONGODB_USERNAME=your-mongodb-username
MONGODB_PASSWORD=your-mongodb-password
MONGODB_DB_NAME=your-database-name

# AI providers (CHAT_MODEL and EMBEDDING_MODEL are required)
# Providers are inferred from model names via app/config/model_pricing.json.
# Only API keys for providers used by those models are required.
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here

# Auth0 Configuration
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_AUDIENCE=your-auth0-audience
# Algorithm for JWT verification (optional, defaults to RS256)
ALGORITHM=RS256

# Optional: comma-separated Auth0 user IDs (JWT `sub`) that are not subject to daily token limits
# TOKEN_LIMIT_BYPASS_USER_IDS=auth0|abc123,auth0|def456
